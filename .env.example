OPENAI_API_KEY=
# Native browser WebRTC speech-to-speech settings. The mini model is the
# latency/cost-oriented default; override only after measuring your workload.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-live-transcribe
OPENAI_REALTIME_TRANSCRIPTION_DELAY=minimal
# Limit expected spoken languages to avoid incorrect script/language detection.
OPENAI_REALTIME_TRANSCRIPTION_LANGUAGES=en
# Semantic endpointing avoids cutting a user off during a natural pause while
# medium gives responsive end-of-turn detection. Allowed values: low, medium,
# high, auto.
OPENAI_REALTIME_VAD_EAGERNESS=medium
OPENAI_FINETUNED_MODEL=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
TTS_PROVIDER=openai
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
MOOD_EXTRACTOR_MODEL=gpt-4o-mini
COACH_MODEL=gpt-4o
CONVERSATION_MODEL=gpt-4o
FINE_TUNE_BASE_MODEL=gpt-4o-mini-2024-07-18
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
STT_PROVIDER=openai
WHISPER_MODEL=base
# If running the backend directly on the host (not via `docker compose up`,
# which sets its own DATABASE_URL pointing at the `postgres` service), first
# start Postgres with `docker compose up -d postgres`. If port 5432 is
# already taken by another local Postgres, remap it in docker-compose.yml
# and update this URL's port to match.
DATABASE_URL=postgresql://mindtrack:mindtrack@localhost:5432/mindtrack
ENABLE_JOB_TRACKER=true
DEMO_MAX_POSTS_PER_HOUR=60
DEMO_MAX_POSTS_PER_HOUR_PER_USER=120
MAX_AUDIO_BYTES=10485760
MAX_TEXT_CHARS=4000
EXTERNAL_API_TIMEOUT_SECONDS=45

# --- Auth ---
# Create an OAuth 2.0 Client ID in Google Cloud Console (Web application
# type), enable the Gmail API, and add the redirect URI below as an
# authorized redirect URI. See DEPLOYMENT.md for the full walkthrough.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URL=http://localhost:8000/auth/callback
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET_KEY=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# Set to true in production (HTTPS); must stay false for local http:// dev.
SESSION_HTTPS_ONLY=false
